# Supabase Configuration
# You must provide these variables for the application to function.

# Public keys (safe to expose to the client)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side ONLY key (NEVER expose to the client via NEXT_PUBLIC_)
# This is used for admin actions (approving/rejecting resources) and generating signed URLs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
