# Supabase Configuration
# You must provide these variables for the application to function.

# Public keys (safe to expose to the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side ONLY key (NEVER expose to the client via NEXT_PUBLIC_)
# Used for server actions, admin moderation, and generating signed URLs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Super Admin Whitelist (comma-separated email list)
ADMIN_EMAILS=admin@cuchd.in,py7716496@gmail.com

# Firebase Project Configuration
FIREBASE_PROJECT_ID=prevu-f35a3

# Transactional Email (Resend) for @cuchd.in Verification
# If omitted in local dev, OTP will log to server console for simulation
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Prevu Verification <verify@prevu.app>

# Google Gemini AI API Key (for AI Question Paper Assistant & Formula Generator)
GEMINI_API_KEY=your-gemini-api-key
